            android:name="com.app.alpha_book.base.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.alpha_book">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>